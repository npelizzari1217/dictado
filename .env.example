# Plantilla de variables de entorno — dictado
#
# Copiar a `.env` y completar. El .env NUNCA se commitea.
# Toda variable nueva se agrega ACA en el mismo commit que la usa
# (regla global de C:\trabajos).
# Los valores de abajo son placeholders, no credenciales reales.

# --- Servidor Express ---
# Puerto donde sirve el front y la API /api. Por defecto 3000.
PORT=3000

# NOTA: las API keys de los proveedores de IA NO van acá.
# Se cargan desde la UI y viven en la tabla `modelos` de server/dictado.db,
# que esta gitignoreada. Ese es el diseno: la key nunca llega al navegador.
