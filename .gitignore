# Dependencias
node_modules/

# Base de datos SQLite (CONTIENE API KEYS — nunca subir)
*.db
*.db-journal
*.db-wal
*.db-shm
server/dictado.db

# Variables de entorno
.env
.env.*

# Logs / sistema
*.log
.DS_Store

# Gentle AI skill registry (generado por maquina, no versionar)
.atl/

# Config local de gga (herramienta personal, no del proyecto)
.gga

# --- Memoria local de trabajo (regla global de C:\trabajos) ---
# Engram es la CACHE local de la maquina; el registro que sobrevive es el
# artifact store commiteado. La base nunca entra al repo: es binaria, cambia
# en cada sesion, y es distinta en cada PC.
.engram/
*.engram.db

# La plantilla SI se commitea: es la documentacion de que variables hacen falta.
!.env.example
